# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Credentials, tokens and secret files (CRITICAL: Never commit)
credentials.json
token.json
client_secret*.json
.env
.env.*
vault_auth.json

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary and backup files
*.log
*.tmp
backups/

# Private and large raw datasets
data/*
!data/.gitkeep
!data/demo_student_mailbox.csv

# Multi-tenant user vaults and sessions (Strictly private)
outputs/users/
outputs/users/*
outputs/last_active_user.json
outputs/cached_classified_inbox.csv
outputs/cached_user_account.json
outputs/prediction_history.csv
outputs/auto_categorized_emails.csv
outputs/emails_needing_review.csv
outputs/combined_550_emails.xlsx
outputs/ml_labeling_queue.xlsx
outputs/archive/

# Machine learning model benchmarks & reports (Retain for evaluation display)
outputs/*
!outputs/model_comparison.csv
!outputs/best_model_classification_report.csv
!outputs/best_model_confusion_matrix.csv
!outputs/fraud_model_comparison.csv
!outputs/fraud_best_model_classification_report.csv
!outputs/fraud_best_model_confusion_matrix.csv
!outputs/fraud_top_keywords.csv
